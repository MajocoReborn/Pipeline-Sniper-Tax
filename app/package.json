{
    "name": "sniper-tax-app",
    "version": "0.1.0",
    "private": true,
    "description": "Launch site for the sniper-tax Pipeline strategy, and its TypeScript client",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run typecheck && npm run format:check && vitest run",
        "vectors": "cargo run -q -p sniper-tax-client --example ts_vectors > test/vectors.json",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@solana/kit": "8.6.0"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "prettier": "3.9.10",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    }
}
