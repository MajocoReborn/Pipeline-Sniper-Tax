{
    "name": "sniper-tax-app",
    "version": "0.1.0",
    "private": true,
    "description": "Launch site for the sniper-tax Pipeline strategy",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run typecheck && npm run format:check && vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "update-sdk": "../scripts/update-sdk.sh"
    },
    "dependencies": {
        "@majocoreborn/sniper-tax-sdk": "file:vendor/majocoreborn-sniper-tax-sdk-0.1.0.tgz",
        "@pipeline-sol/sdk": "0.1.1",
        "@solana-program/system": "0.16.0",
        "@solana-program/token": "0.18.0",
        "@solana-program/token-2022": "0.20.0",
        "@solana/kit": "8.6.0",
        "@solana/react": "8.6.0",
        "@wallet-standard/react": "1.0.3",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "prettier": "3.9.10",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.1.0"
    }
}
